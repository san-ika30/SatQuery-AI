# ============================================================
# SatQuery AI — Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# ----- Hugging Face -----
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_GEOCHAT_MODEL=MBZUAI/GeoChat
HF_BLIP2_MODEL=Salesforce/blip2-opt-2.7b
HF_GROUNDING_DINO_MODEL=IDEA-Research/grounding-dino-tiny
HF_MISTRAL_MODEL=mistralai/Mistral-7B-Instruct-v0.2
HF_CHANGEFORMER_SPACE=your-hf-username/changeformer-space

# ----- Supabase -----
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----- Cloudflare R2 -----
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=satquery-ai
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ----- Backend -----
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ----- Next.js Public (prefix with NEXT_PUBLIC_) -----
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
